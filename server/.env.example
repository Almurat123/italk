# Copy to .env and configure privately. Never commit actual tokens.
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/gateway.sqlite
# At least 32 random characters; per-account token provisioning is required for production.
CLIENT_TOKEN=
CLIENT_SUBJECT=owner
# Set MODEL_PROVIDER=deepseek for the official DeepSeek Flash endpoint; key stays on the server.
MODEL_PROVIDER=generic
MODEL_PROTOCOL=responses
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_ID=gpt-6-luna
# DeepSeek example (replace the generic settings above):
# MODEL_PROVIDER=deepseek
# MODEL_PROTOCOL=chat-completions
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_ID=deepseek-flash
# Enable only after confirming the configured model accepts inline JPEG input.
MODEL_SUPPORTS_IMAGES=false
# Optional account scopes: cloudAI, research, cloudHealth, cloudImages, cloudVoice.
# cloudImages requires explicit per-turn consent, including sensitive image content.
CLIENT_ACCOUNTS_JSON=
# Customer credits, not currency. Set a published commercial rate before accepting purchases.
INPUT_MICROCREDITS_PER_MILLION=1000000
OUTPUT_MICROCREDITS_PER_MILLION=5000000
SEARCH_MICROCREDITS=100000
MAX_OUTPUT_TOKENS=800
# Optional emotional speech; disabled without a key AND per-account cloudVoice scope.
# Reply text only. Microphone audio is not uploaded by this feature.
VOICE_BASE_URL=https://api.minimax.io/v1
VOICE_API_KEY=
VOICE_MODEL_ID=speech-2.8-turbo
VOICE_ID="Chinese (Mandarin)_Warm_Bestie"
VOICE_MICROCREDITS_PER_MILLION_CHARACTERS=1000000
# No purchase credits without Apple verification and a server-owned product mapping.
APPLE_ENVIRONMENT=Sandbox
APPLE_BUNDLE_ID=com.italk.assistant
APPLE_APP_ID=
APPLE_ROOT_CERTIFICATES=
STORE_PRODUCTS_JSON={}
